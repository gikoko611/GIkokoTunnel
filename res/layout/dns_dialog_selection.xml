<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:sweet="http://schemas.android.com/apk/res-auto" xmlns:aapt="http://schemas.android.com/aapt" android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_gravity="center" android:orientation="vertical" android:padding="0dp" android:layout_width="200dp" android:layout_height="60dp" android:layout_marginTop="10dp" android:layout_marginBottom="10dp">
        <Spinner android:id="@+id/dns_spinner" android:background="@drawable/server_frame" android:layout_width="match_parent" android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout android:layout_gravity="center" android:orientation="vertical" android:padding="0dp" android:layout_width="200dp" android:layout_height="wrap_content" android:layout_marginTop="10dp">
        <TextView android:textStyle="bold" android:textColor="#000000" android:id="@+id/custom_dns_textview" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Enter Custom DNS:" android:fontFamily="@font/montserrat_regular"/>
        <TextView android:textSize="10sp" android:textStyle="bold" android:textColor="#000000" android:id="@+id/custom_dns_placeholder" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Can be multiple DNS seperate with ;" android:fontFamily="@font/montserrat_regular"/>
        <EditText android:textSize="13sp" android:textColor="#000000" android:gravity="center" android:id="@+id/custom_dns_edittext" android:background="@drawable/server_frame" android:visibility="gone" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:hint="8.8.8.8" android:maxLines="1" android:maxLength="50" android:inputType="text"/>
    </LinearLayout>
    <LinearLayout android:layout_gravity="center" android:orientation="vertical" android:padding="0dp" android:visibility="gone" android:layout_width="200dp" android:layout_height="wrap_content" android:layout_marginTop="10dp">
        <TextView android:textStyle="bold" android:textColor="#000000" android:visibility="visible" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="GSO Option (can speed up connection, depends on resolver)" android:fontFamily="@font/montserrat_regular"/>
        <CheckBox android:textSize="10sp" android:textColor="#000000" android:gravity="center" android:id="@+id/gsoCheck" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Enable GSO (Generic Segment Offloading)" android:buttonTint="#000000"/>
    </LinearLayout>
</LinearLayout>
