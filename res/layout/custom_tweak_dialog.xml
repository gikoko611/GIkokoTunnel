<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:sweet="http://schemas.android.com/apk/res-auto" xmlns:aapt="http://schemas.android.com/aapt" android:orientation="vertical" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tweak Name"/>
            <EditText android:textColor="#ffffff" android:id="@+id/custom_tweak_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:ems="10" android:inputType="textPersonName"/>
            <TextView android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tweak Mode"/>
            <Spinner android:id="@+id/custom_tweak_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <TextView android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tweak Type"/>
            <Spinner android:id="@+id/custom_tweak_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <TextView android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pre-loaded Payload Type (optional for WebSocket only)"/>
            <Spinner android:id="@+id/preload_pay" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <TextView android:textColor="#ffffff" android:id="@+id/tweak_mode_title" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <EditText android:textSize="12sp" android:textColor="#ffffff" android:id="@+id/custom_tweak_edit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="@string/payload_hint" android:ems="10" android:layout_weight="1" android:inputType="textMultiLine"/>
                <ImageView android:id="@+id/custom_tweak_generate" android:layout_width="35dp" android:layout_height="35dp" android:src="@drawable/ic_generator" android:tint="@color/primary_color"/>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/custom_tweak_sni_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp">
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <EditText android:textColor="#ffffff" android:id="@+id/custom_tweak_sni" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="SNI" android:ems="10" android:inputType="textUri"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/custom_tweak_proxy_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp">
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Proxy Settings" android:layout_weight="1"/>
                    <Switch android:textColor="#ffffff" android:id="@+id/custom_tweak_default_proxy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Use default proxy"/>
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <EditText android:textColor="#ffffff" android:id="@+id/custom_tweak_proxy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="Proxy" android:ems="10" android:inputType="textUri"/>
                    <EditText android:textColor="#ffffff" android:id="@+id/custom_tweak_proxy_port" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="Port" android:ems="10" android:inputType="number"/>
                </LinearLayout>
            </LinearLayout>
            <Button android:textColor="#ffffffff" android:id="@+id/custok_tweak_save" android:background="?attr/colorAccent" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SAVE"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
