<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:sweet="http://schemas.android.com/apk/res-auto" xmlns:aapt="http://schemas.android.com/aapt" android:layout_width="match_parent" android:layout_height="wrap_content" sweet:elevation="0dp" sweet:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" sweet:elevation="0dp" sweet:popupTheme="@style/Theme.AppCompat.Light"/>
        <ImageView android:id="@+id/flip_menu" android:layout_width="30dp" android:layout_height="30dp" android:layout_margin="10dp" android:src="@drawable/more_set" android:layout_centerVertical="true"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" android:layout_centerVertical="true">
            <TextView android:textSize="20sp" android:typeface="serif" android:textStyle="bold" android:textColor="#ff2aceff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="5dp" android:text="HAMARA TUNNEL"/>
        </LinearLayout>
        <ImageView android:id="@+id/account_dialog" android:layout_width="30dp" android:layout_height="30dp" android:layout_margin="10dp" android:src="@drawable/ic_username" android:layout_alignParentRight="true" android:layout_centerVertical="true"/>
    </RelativeLayout>
</com.google.android.material.appbar.AppBarLayout>
