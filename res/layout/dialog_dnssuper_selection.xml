<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:sweet="http://schemas.android.com/apk/res-auto" xmlns:aapt="http://schemas.android.com/aapt" android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_gravity="center" android:orientation="vertical" android:padding="0dp" android:layout_width="200dp" android:layout_height="60dp" android:layout_marginTop="10dp" android:layout_marginBottom="10dp">
        <Spinner android:id="@+id/superdns_spinner" android:background="@drawable/server_frame" android:layout_width="match_parent" android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout android:layout_gravity="center" android:orientation="vertical" android:padding="0dp" android:layout_width="200dp" android:layout_height="wrap_content" android:layout_marginTop="10dp">
        <TextView android:textStyle="bold" android:textColor="#000000" android:id="@+id/custom_superdns_textview" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Enter Custom DNS:" android:fontFamily="@font/montserrat_regular"/>
        <TextView android:textSize="10sp" android:textStyle="bold" android:textColor="#000000" android:id="@+id/custom_superdns_placeholder" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="DNS over UDP Format Example:\10udp://8.8.8.8\10\10DNS over HTTPS Format Example:\10doh://8.8.8.8\10\10DNS over TLS Format Example:\10dot://8.8.8.8" android:fontFamily="@font/montserrat_regular"/>
        <EditText android:textSize="13sp" android:textColor="#000000" android:gravity="center" android:id="@+id/custom_superdns_edittext" android:background="@drawable/server_frame" android:visibility="gone" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:hint="8.8.8.8" android:maxLines="1" android:maxLength="50" android:inputType="text"/>
    </LinearLayout>
    <LinearLayout android:layout_gravity="center" android:orientation="vertical" android:padding="0dp" android:layout_width="200dp" android:layout_height="wrap_content" android:layout_marginTop="10dp">
        <com.michaelmuenzer.android.scrollablennumberpicker.ScrollableNumberPicker android:layout_gravity="center" android:id="@+id/frequency_count" android:background="@drawable/number_picker_bg_color" android:layout_width="100dp" android:layout_height="35dp" android:layout_margin="10dp" android:paddingStart="8dp" android:paddingEnd="8dp" sweet:snp_maxValue="10" sweet:snp_minValue="1" sweet:snp_orientation="0" sweet:snp_stepSize="1" sweet:snp_updateInterval="100" sweet:snp_value="1"/>
        <TextView android:textSize="10sp" android:textStyle="bold" android:textColor="#000000" android:gravity="center" android:id="@+id/custom_frequency_placeholder" android:visibility="visible" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Number of tunnel frequency" android:fontFamily="@font/montserrat_regular"/>
    </LinearLayout>
</LinearLayout>
